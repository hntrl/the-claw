OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=your-cartesia-key-here
CARTESIA_VERSION=2025-04-16
CARTESIA_MODEL_ID=sonic-2
CARTESIA_VOICE_ID=your-cartesia-voice-id
CARTESIA_LANGUAGE=en
CARTESIA_SAMPLE_RATE=44100
CARTESIA_MP3_BIT_RATE=128000
CARTESIA_GENERATION_SPEED=1.0
AGENT_BASE_URL=http://127.0.0.1:8000
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
MIC_SAMPLE_RATE=16000
MAX_RECORD_SECONDS=6
VAD_FRAME_MS=30
VAD_START_THRESHOLD=0.020
VAD_STOP_THRESHOLD=0.012
VAD_MIN_SPEECH_FRAMES=3
VAD_SILENCE_FRAMES_TO_STOP=12
VAD_PREROLL_FRAMES=8
MIN_UTTERANCE_SECONDS=0.5
POST_TTS_COOLDOWN_SECONDS=0.8
