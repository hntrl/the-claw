# Root environment template for the monorepo.
# Copy to `.env` at repo root and fill required values.

### Shared (all agent runtimes)
# Choose runtime: `pipecat` or `realtime`
AGENT_RUNTIME=pipecat

# Required for all current runtimes
OPENAI_API_KEY=
# Optional but recommended if your key context spans multiple projects/orgs.
OPENAI_PROJECT=
OPENAI_ORG=

# Agent websocket + simulation knobs
AGENT_WS_HOST=0.0.0.0
AGENT_WS_PORT=8787
AGENT_SUCCESS_RATE=0.68
AGENT_DEMO_INTERVAL_MS=14000

### Claw controller (shared by pipecat + realtime runtimes)
# auto: try serial and fall back to sim; sim: force simulation; serial: require Arduino serial.
CLAW_CONTROLLER_MODE=auto
# Required for `serial` mode.
CLAW_SERIAL_PORT=/dev/tty.usbmodem
CLAW_SERIAL_BAUD=115200
CLAW_SERIAL_TIMEOUT_S=1.0
# Motion-to-command mapping (degrees sent per directional move).
CLAW_MOVE_X_DEGREES=90
CLAW_MOVE_Y_DEGREES=90
CLAW_MOVE_Z_DOWN_DEGREES=360
CLAW_MOVE_Z_UP_DEGREES=180
# Prompt calibration hints (used by realtime tool-calling prompt).
CLAW_X_DEGREES_PER_FOOT=540
CLAW_Y_DEGREES_PER_FOOT=540
CLAW_Z_DEGREES_PER_FOOT=360
CLAW_DEFAULT_LOWER_DEGREES=1080
# Use firmware `RAISE` for "up" motion when enabled.
CLAW_USE_RAISE_FOR_UP=1
# Prize outcome strategy:
# pending = no win/lose signal yet (recommended with real hardware),
# random = emit success/failure using CLAW_RESULT_SUCCESS_RATE.
CLAW_RESULT_MODE=pending
CLAW_RESULT_SUCCESS_RATE=0.68

# Shared mic/VAD tuning (`--mic` local capture for both runtimes).
# Realtime runtime requires MIC_SAMPLE_RATE >= 24000.
MIC_SAMPLE_RATE=24000
# Optional mic device index or exact device name.
# Use `just agent-audio-devices` to list available input devices.
AGENT_AUDIO_INPUT_DEVICE=
MAX_RECORD_SECONDS=6
VAD_FRAME_MS=30
VAD_START_THRESHOLD=0.020
VAD_STOP_THRESHOLD=0.012
VAD_MIN_SPEECH_FRAMES=3
VAD_SILENCE_FRAMES_TO_STOP=12
VAD_PREROLL_FRAMES=8
MIN_UTTERANCE_SECONDS=0.5
# Barge-in tuning:
AGENT_ENABLE_BARGE_IN=1
# Set higher than VAD_MIN_SPEECH_FRAMES to reduce false interrupt triggers from speaker bleed.
BARGE_IN_MIN_SPEECH_FRAMES=5

### PIPECAT CONFIG

# Pipecat runtime only (`AGENT_RUNTIME=pipecat`)
# OPENAI_MODEL=gpt-4.1-mini
# # Used only for Pipecat `--mic` (local capture -> transcription -> text turn).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# # Cartesia key is only needed when Pipecat local TTS is enabled.
# CARTESIA_API_KEY=
# AGENT_TTS_ENABLED=1
# CARTESIA_MODEL_ID=sonic-3
# CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
# CARTESIA_LANGUAGE=en
# CARTESIA_SAMPLE_RATE=44100

### REALTIME CONFIG
# Realtime runtime only (`AGENT_RUNTIME=realtime`)
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_VOICE=marin
# Realtime voice + turn tuning defaults chosen to reduce self-interruption on speakers.
# OPENAI_REALTIME_TURN_EAGERNESS=low
# OPENAI_REALTIME_TURN_CREATE_RESPONSE=1
# Keep this `0` unless you're on headset / clean echo path.
# OPENAI_REALTIME_TURN_INTERRUPT_RESPONSE=0
# Explicit barge-in gate in this service (recommended off on open speakers).
# OPENAI_REALTIME_BARGE_IN_ENABLED=0
# Ignore barge-in detections this long after assistant speech starts.
# OPENAI_REALTIME_BARGE_IN_GRACE_MS=900
# `near_field` usually reduces speaker bleed better for desktop/laptop mic setups.
# OPENAI_REALTIME_NOISE_REDUCTION=near_field
# Optional speaking rate for realtime voice output (0.5 - 2.0 recommended).
# OPENAI_REALTIME_SPEED=1.2
# Minimum PCM depth to batch before forwarding to Realtime. Protects against
# provider-side "audio buffer too small/0ms" fatal errors.
# OPENAI_REALTIME_MIN_INPUT_AUDIO_MS=120
# AGENT_REALTIME_PLAY_AUDIO=1
# Mic ducking to reduce speaker bleed triggering false turns.
# Keep enabled unless you're using headphones.
# OPENAI_REALTIME_INPUT_DUCKING=1
# OPENAI_REALTIME_DUCKING_TAIL_MS=280
# Barge-in gate when ducking is active (normalized RMS 0..1 and min voiced duration).
# OPENAI_REALTIME_BARGE_IN_MIN_RMS=0.03
# OPENAI_REALTIME_BARGE_IN_MIN_MS=120
# Optional diagnostics for local tuning.
# OPENAI_REALTIME_INPUT_GATE_LOG=0
# OPENAI_REALTIME_INPUT_GATE_LOG_INTERVAL_S=5
# Optional explicit speaker device (index or exact device name).
# Leave empty to use system default; runtime will fallback to first output-capable device.
# AGENT_AUDIO_OUTPUT_DEVICE=

### Web app
# Set this in `packages/web/.env.local` for Vite, or pass `?ws=...` query param.
VITE_DISPLAY_WS_URL=ws://127.0.0.1:8787
